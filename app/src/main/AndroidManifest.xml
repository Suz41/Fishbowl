<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly"
    android:sharedUserId="${TERMUX_PACKAGE_NAME}"
    android:sharedUserLabel="@string/shared_user_label">

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="com.fishbowl.app.FishbowlApplication"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/fishbowl_name"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.TermuxApp.DayNight.DarkActionBar"
        android:usesCleartextTraffic="true"
        tools:targetApi="m">

        <activity
            android:name=".app.TermuxActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|keyboard|keyboardHidden|navigation"
            android:label="@string/application_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.TermuxActivity.DayNight.NoActionBar"
            tools:targetApi="n" />

        <activity
            android:name="com.fishbowl.app.FishbowlActivity"
            android:exported="true"
            android:label="@string/fishbowl_name"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|keyboard|keyboardHidden|navigation|uiMode|fontScale|fontWeightAdjustment|locale|layoutDirection"
            android:theme="@style/Theme.TermuxApp.DayNight.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Native Android Quick Settings Tile Preferences Long-Press Target -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.fishbowl.app.JellyfinStorageActivity"
            android:exported="false"
            android:label="Media Storage"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|keyboard|keyboardHidden|navigation|uiMode|fontScale|fontWeightAdjustment|locale|layoutDirection"
            android:theme="@style/Theme.TermuxApp.DayNight.NoActionBar" />
        <activity
            android:name="com.fishbowl.app.importer.MovieImportActivity"
            android:exported="true"
            android:label="Movie Importer"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|keyboard|keyboardHidden|navigation|uiMode|fontScale|fontWeightAdjustment|locale|layoutDirection"
            android:theme="@style/Theme.TermuxApp.DayNight.NoActionBar">
            <intent-filter>
                <action android:name="com.fishbowl.app.ACTION_REVIEW_IMPORT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.fishbowl.app.JellyfinWebActivity"
            android:exported="false"
            android:label="Fishbowl Web"
            android:theme="@style/Theme.TermuxApp.DayNight.NoActionBar"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|keyboard|keyboardHidden|navigation|uiMode|fontScale|fontWeightAdjustment|locale|layoutDirection" />

        <activity
            android:name=".app.activities.SettingsActivity"
            android:exported="true"
            android:label="@string/title_activity_termux_settings"
            android:theme="@style/Theme.TermuxApp.DayNight.NoActionBar" />

        <activity
            android:name=".shared.activities.ReportActivity"
            android:theme="@style/Theme.MarkdownViewActivity.DayNight"
            android:documentLaunchMode="intoExisting" />


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${TERMUX_PACKAGE_NAME}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".app.event.SystemEventReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>


        <!-- Fishbowl Jellyfin Password Reset PIN Notification Copy Action -->
        <receiver
            android:name="com.fishbowl.app.CopyPinReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.fishbowl.app.ACTION_COPY_PIN" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".shared.activities.ReportActivity$ReportActivityBroadcastReceiver"
            android:exported="false" />

        <!-- Phase 10: Android Home Screen Widget Provider -->
        <receiver
            android:name="com.fishbowl.app.widget.FishbowlWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.fishbowl.app.widget.ACTION_WIDGET_UPDATE" />
                <action android:name="com.fishbowl.app.widget.ACTION_TOGGLE_SERVER" />
                <action android:name="com.fishbowl.app.widget.ACTION_START_ALL" />
                <action android:name="com.fishbowl.app.widget.ACTION_RESTART_ALL" />
                <action android:name="com.fishbowl.app.widget.ACTION_STOP_ALL" />
                <action android:name="com.fishbowl.app.widget.ACTION_PIN_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fishbowl_widget_info" />
        </receiver>

        <receiver
            android:name="com.fishbowl.app.widget.FishbowlServicesWidgetProvider"
            android:label="@string/fishbowl_services_widget_name"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.fishbowl.app.widget.ACTION_SERVICES_WIDGET_UPDATE" />
                <action android:name="com.fishbowl.app.widget.ACTION_TOGGLE_SERVICE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/fishbowl_services_widget_info" />
        </receiver>

        <service
            android:name=".app.TermuxService"
            android:exported="false" />

        <!-- Phase 9: Foreground service for background reliability and notification -->
        <service
            android:name="com.fishbowl.app.JellyfinServerService"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false"
            android:exported="false" />

        <!-- Native Android Quick Settings Tile (Jellyfin Server Controller) -->
        <service
            android:name="com.fishbowl.app.FishbowlQuickSettingsTileService"
            android:label="@string/quick_settings_tile_label"
            android:icon="@drawable/ic_fishbowl_logo"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true"
            tools:targetApi="n">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>


        <!-- This (or rather, value 2.1 or higher) is needed to make the Samsung Galaxy S8 mark the
        app with "This app is optimized to run in full screen." -->
        <meta-data
            android:name="android.max_aspect"
            android:value="10.0" />


        <!-- https://developer.samsung.com/samsung-dex/modify-optimizing.html -->

        <!-- Version < 3.0. DeX Mode and Screen Mirroring support -->
        <meta-data
            android:name="com.samsung.android.keepalive.density"
            android:value="true" />

        <!-- Version >= 3.0. DeX Dual Mode support -->
        <meta-data
            android:name="com.samsung.android.multidisplay.keep_process_alive"
            android:value="true" />

        <meta-data
            android:name="com.sec.android.support.multiwindow"
            android:value="true" />

    </application>

</manifest>
